{
  "name": "fullstack-template",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint && pnpm lint:ascii",
    "lint:ascii": "bash scripts/check-ascii.sh",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm --filter @template/web validate:mcp && pnpm build && cd services/worker && make verify && cd ../../services/python && make verify && cd ../../infra/cdk && pnpm exec tsc --noEmit && pnpm exec vitest run && cd ../.. && pnpm format:check",
    "clean": "turbo clean",
    "translate": "./scripts/translate.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-i18next": "^6.1.4",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "turbo": "^2",
    "typescript-eslint": "^8.59.3"
  }
}
