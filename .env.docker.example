# ═══════════════════════════════════════════════════════════════
# Docker Production Environment Variables
#
# Copy this file to .env and fill in the values before deploying.
# All variables marked [REQUIRED] must be set.
# ═══════════════════════════════════════════════════════════════

# ─── Auth [REQUIRED] ──────────────────────────────────────────
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# The public URL where the app is accessible
BETTER_AUTH_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─── Database [REQUIRED] ──────────────────────────────────────
# If using the bundled Postgres container:
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@db:5432/template
# Postgres container credentials (change these!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=template

# ─── Deployment ───────────────────────────────────────────────
DEPLOY_TARGET=docker
NODE_ENV=production

# ─── Email ────────────────────────────────────────────────────
# For Docker mode, configure a real SMTP server for production:
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
EMAIL_FROM=noreply@your-domain.com

# ─── Payments (optional — leave empty to disable) ─────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── OAuth (optional) ────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Storage (optional) ──────────────────────────────────────
# S3_BUCKET_NAME=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Analytics (optional) ────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ─── MCP API (optional — secures /api/mcp in production) ─────
# Generate with: openssl rand -hex 32
# MCP_API_KEY=

# ─── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=info

# ─── Seed (optional — only for initial setup) ────────────────
# SEED_ADMIN_PASSWORD=
