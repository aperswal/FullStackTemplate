// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DatabaseStack > matches snapshot 1`] = `
{
  "Outputs": {
    "DbEndpoint": {
      "Description": "RDS endpoint address",
      "Value": {
        "Fn::GetAtt": [
          "DatabaseB269D8BB",
          "Endpoint.Address",
        ],
      },
    },
    "DbSecretArn": {
      "Description": "Secrets Manager ARN for database credentials",
      "Value": {
        "Ref": "DatabaseSecretAttachmentE5D1B020",
      },
    },
  },
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "DatabaseB269D8BB": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "AllocatedStorage": "20",
        "BackupRetentionPeriod": 3,
        "CopyTagsToSnapshot": true,
        "DBInstanceClass": "db.t4g.micro",
        "DBInstanceIdentifier": "fullstack-template-db-dev",
        "DBName": "fullstack_template",
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnetGroup7D60F180",
        },
        "DeletionProtection": false,
        "Engine": "postgres",
        "EngineVersion": "16",
        "MasterUserPassword": {
          "Fn::Join": [
            "",
            [
              "{{resolve:secretsmanager:",
              {
                "Ref": "TestDatabaseStackDatabaseSecretF4BBDDD13fdaad7efa858a3daf9490cf0a702aeb",
              },
              ":SecretString:password::}}",
            ],
          ],
        },
        "MasterUsername": "postgres",
        "MaxAllocatedStorage": 100,
        "MultiAZ": false,
        "PubliclyAccessible": false,
        "StorageEncrypted": true,
        "StorageType": "gp2",
        "VPCSecurityGroups": [
          {
            "Fn::GetAtt": [
              "DbSecurityGroupE9D701AD",
              "GroupId",
            ],
          },
        ],
      },
      "Type": "AWS::RDS::DBInstance",
      "UpdateReplacePolicy": "Delete",
    },
    "DatabaseSecretAttachmentE5D1B020": {
      "Properties": {
        "SecretId": {
          "Ref": "TestDatabaseStackDatabaseSecretF4BBDDD13fdaad7efa858a3daf9490cf0a702aeb",
        },
        "TargetId": {
          "Ref": "DatabaseB269D8BB",
        },
        "TargetType": "AWS::RDS::DBInstance",
      },
      "Type": "AWS::SecretsManager::SecretTargetAttachment",
    },
    "DatabaseSubnetGroup7D60F180": {
      "Properties": {
        "DBSubnetGroupDescription": "Subnet group for Database database",
        "SubnetIds": [
          {
            "Fn::ImportValue": "TestNetworkingStack:ExportsOutputRefVpcisolatedSubnet1SubnetE62B1B9BEE029908",
          },
          {
            "Fn::ImportValue": "TestNetworkingStack:ExportsOutputRefVpcisolatedSubnet2Subnet392170557C27A199",
          },
        ],
      },
      "Type": "AWS::RDS::DBSubnetGroup",
    },
    "DbSecurityGroupE9D701AD": {
      "Properties": {
        "GroupDescription": "Security group for RDS PostgreSQL — only accepts traffic from app services",
        "GroupName": "fullstack-template-db-sg-dev",
        "SecurityGroupEgress": [
          {
            "CidrIp": "255.255.255.255/32",
            "Description": "Disallow all traffic",
            "FromPort": 252,
            "IpProtocol": "icmp",
            "ToPort": 86,
          },
        ],
        "VpcId": {
          "Fn::ImportValue": "TestNetworkingStack:ExportsOutputRefVpc8378EB38272D6E3A",
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "TestDatabaseStackDatabaseSecretF4BBDDD13fdaad7efa858a3daf9490cf0a702aeb": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "Description": {
          "Fn::Join": [
            "",
            [
              "Generated by the CDK for stack: ",
              {
                "Ref": "AWS::StackName",
              },
            ],
          ],
        },
        "GenerateSecretString": {
          "ExcludeCharacters": " %+~\`#$&*()|[]{}:;<>?!'/@"\\",
          "GenerateStringKey": "password",
          "PasswordLength": 30,
          "SecretStringTemplate": "{"username":"postgres"}",
        },
        "Name": "fullstack-template/dev/db-credentials",
      },
      "Type": "AWS::SecretsManager::Secret",
      "UpdateReplacePolicy": "Delete",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;
