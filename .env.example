# ═══════════════════════════════════════════════════════════════
# Full-Stack Template — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Deployment ─────────────────────────────────────────────────
# "vercel" for SaaS mode (Resend email, Vercel hosting)
# "docker" for self-hosted/open-source (SMTP email, Docker hosting)
# Controls: email provider, Next.js output mode, analytics defaults
DEPLOY_TARGET=docker

# Set to "true" to seed the database on first Docker startup
SEED_DATABASE=false

# ─── Application ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────
# Direct access (outside Docker):  postgresql://postgres:postgres@localhost:5432/template
# Inside Docker Compose (service):  postgresql://postgres:postgres@db:5432/template
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template

# ─── Authentication (BetterAuth) ────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Payments (Stripe) ─────────────────────────────────────────
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Price ID for the Pro plan — get from Stripe Dashboard > Products
STRIPE_PRO_PRICE_ID=

# ─── Email ──────────────────────────────────────────────────────
# SaaS mode (DEPLOY_TARGET=vercel): uses Resend
RESEND_API_KEY=

# Docker mode (DEPLOY_TARGET=docker): uses SMTP (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@example.com

# ─── AI APIs (optional) ────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Analytics (PostHog) ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Storage (AWS S3) ──────────────────────────────────────────
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Infrastructure (AWS CDK) ──────────────────────────────────
AWS_ACCOUNT_ID=

# ─── Cloudflare (optional) ─────────────────────────────────────
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ─── Translation (i18n auto-translate) ─────────────────────────
# Used by `pnpm translate` to auto-translate messages/en.json
# Google Cloud Translation: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=
# DeepL (alternative): https://www.deepl.com/your-account/keys
DEEPL_API_KEY=

# ─── Rate Limiting (Upstash Redis) ─────────────────────────────
# Required for distributed rate limiting on Vercel/SaaS deployments.
# Falls back to in-memory rate limiting when not set (fine for single-instance Docker).
# Get credentials from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── MCP (Model Context Protocol) ─────────────────────────────
# Secures the /api/mcp endpoint in production. Min 32 characters.
# Generate with: openssl rand -base64 32
MCP_API_KEY=

# ─── SEO ────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
